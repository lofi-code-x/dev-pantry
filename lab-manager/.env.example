LAB_BIND_ADDR=0.0.0.0:3010
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# For dev-only wildcard CORS:
# CORS_ALLOW_ORIGINS=*

LAB_IMAGE=lab-image:latest
AUTH_SHARED_SECRET=

MAX_SESSIONS_GLOBAL=6
MAX_SESSIONS_PER_USER=1

SESSION_TTL_SECS=1800
IDLE_TTL_SECS=600

CONTAINER_MEMORY=192m
CONTAINER_CPUS=0.25
CONTAINER_PIDS=128

# network mode: none | lab_net (если потом захочешь доступ к сети)
CONTAINER_NETWORK=none

# user inside container
CONTAINER_USER=1000:1000

# Remove containers labeled as managed by lab-manager on startup
STARTUP_CLEANUP_MANAGED_CONTAINERS=true
